#!/usr/bin/env bash
# lab-netem <retardo_ms>   fija el retardo de salida en la interfaz del laboratorio
# lab-netem show           muestra el retardo actual
# Imprime "changed ..." o "unchanged ..." para que Ansible sepa si hubo cambio.
set -euo pipefail

prefix="${LAB_NET_PREFIX:-192.168.56.}"
iface=$(ip -o -4 addr show | awk -v p="$prefix" 'index($4, p) == 1 { print $2; exit }')
if [[ -z "$iface" ]]; then
  echo "no hay interfaz con dirección ${prefix}x" >&2
  exit 1
fi

current=$(tc qdisc show dev "$iface" root | sed -n 's/.*netem.* delay \([0-9.]*\)ms.*/\1/p')
current="${current:-0}"
want="${1:-show}"

if [[ "$want" == "show" ]]; then
  echo "$iface ${current}ms"
  exit 0
fi
if [[ "$current" == "$want" ]]; then
  echo "unchanged $iface ${want}ms"
  exit 0
fi
if [[ "$want" == "0" ]]; then
  tc qdisc del dev "$iface" root 2>/dev/null || true
else
  # limit alto: con 100 ms de retardo la cola de netem retiene muchos paquetes
  # y con el límite por defecto (1000) descartaría ráfagas grandes.
  tc qdisc replace dev "$iface" root netem delay "${want}ms" limit 10000
fi
echo "changed $iface ${want}ms"
