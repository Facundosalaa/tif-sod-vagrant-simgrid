{
  "uid": "agrolab",
  "title": "AgroLab - clúster de planificación",
  "tags": [
    "agrolab",
    "sod"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Corrida en curso",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agrolab_run_active",
          "legendFormat": "activa",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Estrategia",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agrolab_strategy == 1",
          "legendFormat": "{{strategy}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Tareas despachadas (corrida)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agrolab_run_dispatched)",
          "legendFormat": "tareas",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Tareas completadas (corrida)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agrolab_run_completed)",
          "legendFormat": "tareas",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Cola de cada trabajador",
      "description": "Tareas recibidas que esperan ejecución en cada trabajador.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agrolab_queue_length",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pendientes según el coordinador",
      "description": "Despachadas y todavía sin confirmar (la información que usa Menos cargado).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agrolab_outstanding",
          "legendFormat": "{{worker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU usada por nodo (núcleos)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(node_cpu_seconds_total{mode!=\"idle\"}[10s]))",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tareas completadas por segundo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(agrolab_tasks_completed_total[10s])",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pedidos de robo (robo de trabajo)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, result) (increase(agrolab_steal_requests_total[10s]))",
          "legendFormat": "{{node}} {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tráfico de red transmitido",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[10s]))",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memoria disponible",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Carga del sistema (1 min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-agrolab"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-agrolab"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "editable": true
}
